    {
      "name": "4. Empresa A — encuesta",
      "item": [
        {
          "name": "Categorías disponibles",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenSstA}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/encuestas/categorias-disponibles"
          }
        },
        {
          "name": "Tipos de respuesta",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenSstA}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/encuestas/tipos-respuesta"
          }
        },
        {
          "name": "Crear encuesta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.environment.set('encuestaIdA', j.id);",
                  "pm.environment.set('versionBorradorIdA', j.versionBorradorId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenSstA}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Condiciones de trabajo en obra\",\n  \"instrucciones\": \"Responde con lo que vives en la obra. No hay respuestas correctas.\",\n  \"categoriaRiesgoIds\": [\"{{categoriaId}}\"]\n}"
            },
            "url": "{{baseUrl}}/api/encuestas"
          }
        },
        {
          "name": "GET detalle encuesta (guardar secciones/preguntas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const v = pm.response.json().versionBorrador;",
                  "if (v.secciones && v.secciones.length) pm.environment.set('seccionIdA', v.secciones[0].id);",
                  "const p = v.preguntas.find(x => x.tipoRespuestaCodigo === 'seleccion_unica') || v.preguntas[0];",
                  "pm.environment.set('preguntaEncuestaIdA', p.id);",
                  "if (p.opciones && p.opciones.length) pm.environment.set('opcionIdA', p.opciones[0].id);",
                  "const b = v.preguntas.find(x => x.tipoRespuestaCodigo === 'respuesta_breve');",
                  "if (b) pm.environment.set('preguntaBreveIdA', b.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenSstA}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/encuestas/{{encuestaIdA}}"
          }
        },
        {
          "name": "Publicar v1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('versionPublicadaIdA', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenSstA}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/encuestas/{{encuestaIdA}}/versiones/{{versionBorradorIdA}}/publicacion"
          }
        },
        {
          "name": "Editar la encuesta ya publicada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const token = pm.environment.get('tokenSstA');",
                  "const base = pm.environment.get('baseUrl');",
                  "const id = pm.environment.get('encuestaIdA');",
                  "pm.sendRequest({",
                  "  url: `${base}/api/encuestas/${id}`,",
                  "  method: 'GET',",
                  "  header: { Authorization: `Bearer ${token}` }",
                  "}, (err, res) => {",
                  "  const pub = res.json().versionPublicada;",
                  "  pm.variables.set('bodyBorradorV2', JSON.stringify({",
                  "    instrucciones: 'Revisa cómo mueves el material en la obra.',",
                  "    secciones: pub.secciones.map(s => ({ id: s.id, titulo: s.titulo + ' (edit)', orden: s.orden })),",
                  "    preguntas: pub.preguntas.map(p => ({",
                  "      id: p.id,",
                  "      seccionId: p.seccionId,",
                  "      texto: p.texto,",
                  "      tipoRespuestaCodigo: p.tipoRespuestaCodigo,",
                  "      obligatoria: p.obligatoria,",
                  "      peligroId: p.peligroId,",
                  "      orden: p.orden,",
                  "      opciones: (p.opciones || []).map(o => ({ texto: o.texto, orden: o.orden, indicaExposicion: o.indicaExposicion }))",
                  "    }))",
                  "  }));",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('La edición queda guardada', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Queda un borrador nuevo', () => {",
                  "  pm.expect(j.estado).to.eql('borrador');",
                  "  pm.expect(j.numeroVersion).to.be.above(1);",
                  "});",
                  "if (j.secciones && j.secciones.length) {",
                  "  pm.test('La sección del borrador es distinta a la publicada', () => {",
                  "    pm.expect(j.secciones[0].id).to.not.eql(pm.environment.get('seccionIdA'));",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenSstA}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{{bodyBorradorV2}}"
            },
            "url": "{{baseUrl}}/api/encuestas/{{encuestaIdA}}/borrador",
            "description": "Toma las secciones y preguntas de la versión publicada y las guarda como borrador nuevo."
          }
        },
        {
          "name": "Login encuestado A1",
          "event": [
            {
              "listen": "test",
