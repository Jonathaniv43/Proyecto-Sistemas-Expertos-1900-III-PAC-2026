# Copiar a .env en esta carpeta (Norvia.API). No commitear .env.
ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=NorviaDB;Username=admin;Password=SuperSecretPassword123!"

Jwt__Key="cambiar-esta-clave-dev-norvia-minimo-32-chars"
Jwt__Issuer="norvia"
Jwt__Audience="norvia"
Jwt__AccessMinutos="15"
Jwt__RefreshDias="7"
EmpresaId__Key="cambiar-clave-cifrado-empresa-id"

# Obligatorios en desarrollo (StaffSeeder); sin estos valores la API no arranca el seed.
StaffSeed__Email="admin@norvia.local"
StaffSeed__Password="NorviaAdmin123!"
