# Copiar como .env.local (no se versiona).

# Producción: URL base de la API, terminada en /api.
# En desarrollo se deja vacía y las peticiones a /api pasan por el proxy de Vite.
# VITE_API_URL=https://norvia-api.example.com/api

# Desarrollo: a dónde reenvía el proxy de Vite las peticiones a /api (por defecto, la API local).
# VITE_API_PROXY=http://localhost:5167
VITE_MICROSOFT_CLIENT_ID="cambiar"
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
VITE_MICROSOFT_TENANT=common