# Copiar a .env en esta carpeta (Norvia.API). No commitear .env.
ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=NorviaDB;Username=admin;Password=SuperSecretPassword123!"

Jwt__Key="cambiar-esta-clave-dev-norvia-minimo-32-chars"
Jwt__Issuer="norvia"
Jwt__Audience="norvia"
Jwt__AccessMinutos="15"
Jwt__RefreshDias="7"
EmpresaId__Key="cambiar-clave-cifrado-empresa-id"

# Orígenes del frontend que pueden llamar a la API desde el navegador (coma entre cada uno, sin barra final).
# En desarrollo ya vale http://localhost:5173 (appsettings.Development.json); en producción es obligatorio
# (URL de Vercel/Netlify) y la API no arranca sin él.
# Cors__Origenes="https://norvia.vercel.app"

# Obligatorios en desarrollo (StaffSeeder); sin estos valores la API no arranca el seed.
StaffSeed__Email="admin@norvia.local"
StaffSeed__Password="NorviaAdmin123!"

# SMTP Norvia (pruebas: Mailpit en localhost:1025)
Correo__Host="smtp.gmail.com"
Correo__Port="587" 
Correo__UseSsl="true"
Correo__Usuario="norviaenterprise@gmail.com"
Correo__Password="pass de gmail"
Correo__Remitente="noreply@norviaenterprise.com"
Correo__RemitenteNombre="Norvia"
Correo__UrlBaseFrontend="https://norviaenterprise.com"

# Correo de las notificaciones (HU-118): bandeja de salida con reintentos. Todos tienen valor por defecto; descomentar
# solo para cambiarlos. Con los valores por defecto se intenta 5 veces en ~15 min (esperas de 1, 2, 4 y 8 min).
# Notificaciones__Habilitado="true"          # "false" apaga el envío (las notificaciones se siguen creando)
# Notificaciones__IntervaloSegundos="30"     # cada cuánto se revisan los pendientes
# Notificaciones__MaxIntentos="5"            # intentos en total; al agotarlos el correo queda "fallido"
# Notificaciones__EsperaBaseSegundos="60"    # espera tras el primer fallo; se duplica en cada fallo
# Notificaciones__EsperaMaximaSegundos="3600" # tope de la espera entre intentos
# Notificaciones__LoteMaximo="20"            # correos por vuelta, para no saturar el SMTP

# Contenido SST inicial (HU-097): categorías, preguntas, peligros y plantillas. Se carga al arrancar y solo agrega
# lo que falta. Por defecto se carga; "false" lo apaga (las pruebas de integración lo apagan).
# CatalogoSst__Cargar="false"
