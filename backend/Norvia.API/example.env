# Copiar a .env en esta carpeta (Norvia.API). No commitear .env.
# Nota: sin comillas en los valores — Docker (--env-file) no las quita, las dejaría como parte del valor literal.
#Agregando comentario para prueba de autodespligue
ConnectionStrings__PostgresConnection=Host=localhost;Port=5432;Database=NorviaDB;Username=admin;Password=SuperSecretPassword123!

Jwt__Key=cambiar-esta-clave-dev-norvia-minimo-32-chars
Jwt__Issuer=norvia
Jwt__Audience=norvia
Jwt__AccessMinutos=15
Jwt__RefreshDias=7
EmpresaId__Key=cambiar-clave-cifrado-empresa-id

# Orígenes del frontend que pueden llamar a la API desde el navegador (coma entre cada uno, sin barra final).
# En desarrollo ya vale http://localhost:5173 (appsettings.Development.json); en producción es obligatorio
# (URL de Vercel/Netlify) y la API no arranca sin él.
# Cors__Origenes=https://norvia.vercel.app

# Inicio de sesión y registro con Microsoft (D29, HU-119, HU-120). Se crea en Azure: Microsoft Entra ID > Registros de
# aplicaciones > Nueva (plataforma "Web"), con permisos delegados openid, profile y email.
# Tenant: "common" acepta cuentas de trabajo y personales; un GUID restringe a un solo directorio.
# RedirectUris: las mismas que se registraron en Azure (coma entre cada una). El secreto NO se commitea.
Microsoft__ClientId=id-de-la-aplicacion-en-azure
Microsoft__ClientSecret=valor-del-secreto-de-cliente
Microsoft__Tenant=common
Microsoft__RedirectUris=http://localhost:5173/auth/microsoft/callback

# Obligatorios en desarrollo (StaffSeeder); sin estos valores la API no arranca el seed.
StaffSeed__Email=admin@norvia.local
StaffSeed__Password=NorviaAdmin123!

# Resend (envío de correos). El API key se genera en el dashboard de Resend.
Correo__ApiKeyResend=tu_api_key_de_resend
Correo__Remitente=noreply@norviaenterprise.com
Correo__RemitenteNombre=Norvia
Correo__UrlBaseFrontend=https://norviaenterprise.com

# Correo de las notificaciones (HU-118): bandeja de salida con reintentos. Todos tienen valor por defecto; descomentar
# solo para cambiarlos. Con los valores por defecto se intenta 5 veces en ~15 min (esperas de 1, 2, 4 y 8 min).
# "false" apaga el envío (las notificaciones se siguen creando)
# Notificaciones__Habilitado=true
# cada cuánto se revisan los pendientes
# Notificaciones__IntervaloSegundos=30
# intentos en total; al agotarlos el correo queda "fallido"
# Notificaciones__MaxIntentos=5
# espera tras el primer fallo; se duplica en cada fallo
# Notificaciones__EsperaBaseSegundos=60
# tope de la espera entre intentos
# Notificaciones__EsperaMaximaSegundos=3600
# correos por vuelta, para no saturar el servicio de correo
# Notificaciones__LoteMaximo=20

# Contenido SST inicial (HU-097): categorías, preguntas, peligros y plantillas. Se carga al arrancar y solo agrega
# lo que falta. Por defecto se carga; "false" lo apaga (las pruebas de integración lo apagan).
# CatalogoSst__Cargar=false
